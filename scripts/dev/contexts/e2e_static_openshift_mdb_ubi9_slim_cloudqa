#!/usr/bin/env bash

set -Eeou pipefail

script_name=$(readlink -f "${BASH_SOURCE[0]}")
script_dir=$(dirname "${script_name}")

source "${script_dir}/e2e_static_openshift_mdb_ubi_cloudqa"

export MDB_DEFAULT_IMAGE_TYPE=ubi9-slim
# 5.x has no ubi9-slim image, so the previous version stays on 6.0 (counterpart uses the 5.0.1 prev default)
export CUSTOM_MDB_VERSION=6.0.29
export CUSTOM_MDB_PREV_VERSION=6.0.27
