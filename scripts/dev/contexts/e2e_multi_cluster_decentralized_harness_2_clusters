#!/usr/bin/env bash

set -Eeou pipefail

script_name=$(readlink -f "${BASH_SOURCE[0]}")
script_dir=$(dirname "${script_name}")

source "${script_dir}/e2e_multi_cluster_decentralized_harness"

# Two-member twin of the regression harness, for the legacy tests written against the
# e2e_multi_cluster_2_clusters topology. The leader stays pinned on kind-e2e-cluster-1.
export MEMBER_CLUSTERS="kind-e2e-cluster-1 kind-e2e-cluster-2"
