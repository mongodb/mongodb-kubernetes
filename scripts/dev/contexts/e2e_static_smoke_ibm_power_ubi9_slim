#!/usr/bin/env bash

set -Eeou pipefail

script_name=$(readlink -f "${BASH_SOURCE[0]}")
script_dir=$(dirname "${script_name}")

source "${script_dir}/e2e_static_smoke_ibm_power"

export MDB_DEFAULT_IMAGE_TYPE=ubi9-slim
# 7.0 ubi9-slim has no ppc64le builds, so prev stays on 8.0; 8.0.19 and 8.0.29
# are the 8.0 ubi9-slim patches around the gap (8.0.20-8.0.28) that ship ppc64le
export CUSTOM_MDB_VERSION=8.0.29-ent
export CUSTOM_MDB_PREV_VERSION=8.0.19
