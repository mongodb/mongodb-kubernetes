#!/usr/bin/env bash

set -Eeou pipefail

script_name=$(readlink -f "${BASH_SOURCE[0]}")
script_dir=$(dirname "${script_name}")

source "${script_dir}/root-context"
source "${script_dir}/variables/om70"

# This is required to be able to rebuild the om image and use that image which has been rebuilt
export MDB_MAX_CONCURRENT_RECONCILES=30
export MDB_DEFAULT_ARCHITECTURE=static-ga
export MDB_CUSTOM_AGENT_URL="https://mciuploads.s3.amazonaws.com/mms-automation/mongodb-mms-build-agent/builds/patches/6af47fb6bdb4ff00078d94c8/automation-agent/local/mongodb-mms-automation-agent-110.0.0.9428-1.rhel8_x86_64.tar.gz"
export MDB_CUSTOM_AGENT_VERSION=110.0.0.9428-1
export KUBE_ENVIRONMENT_NAME=performance
