#!/usr/bin/env bash

set -Eeou pipefail

# One image per Ops Manager major, built from the latest build of its release branch. Each image is tagged
# <major>-dev-<OPERATOR_VERSION>, the evergreen id of the run, see build_om_image. The tests run against the last
# major, so CUSTOM_OM_VERSION is its tag, see single_e2e.sh.
export OM_DEV_RELEASE_LINES="8 9"
export OM_VERSION="dev-${OPERATOR_VERSION}"
export ops_manager_version="${OM_VERSION}"
export CUSTOM_OM_VERSION="${OM_DEV_RELEASE_LINES##* }-dev-${OPERATOR_VERSION}"

# Build from the unreleased Ops Manager builds instead of the released ones.
export OM_DEV_BUILD=true
