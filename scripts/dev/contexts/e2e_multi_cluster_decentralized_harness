#!/usr/bin/env bash

set -Eeou pipefail

script_name=$(readlink -f "${BASH_SOURCE[0]}")
script_dir=$(dirname "${script_name}")

source "${script_dir}/e2e_multi_cluster_decentralized_kind"

# M7 regression-harness variant: the legacy suite reads CR status through the central
# cluster's client, and the decentralized mode has no central operator — so the status-read
# cluster must be one of the operator-bearing members, with the leader pinned there.
export CENTRAL_CLUSTER=kind-e2e-cluster-1
export CLUSTER_NAME="kind-e2e-cluster-1"
export OPERATOR_LEADER_CLUSTER_NAME=kind-e2e-cluster-1
export DECENTRALIZED_E2E=true
export LOCAL_OPERATOR=false
