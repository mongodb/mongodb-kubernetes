#!/usr/bin/env bash
#
# wt-ctl — unified worktree + devcontainer control plane.
#
# Thin shim: load the worktree env via set_env_context (activates the venv and
# prepends bin/ to PATH), put the wt_ctl package on PYTHONPATH so ``import
# wt_ctl`` resolves regardless of cwd, then exec ``python3 -m wt_ctl``. wt-ctl
# always runs from a worktree that worktree_init has already prepared, so the
# env files and venv are present. See ``scripts/dev/wt-ctl --help``.
#
set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load the worktree env (venv activation, bin/ on PATH) when it exists. A
# fresh worktree — or one checked out from a branch without this tooling —
# has no .generated env yet; wt_ctl itself is stdlib-only Python, so fall
# back to bare python3 rather than refusing to run (wt-ctl create/switch are
# exactly the verbs that bootstrap that env).
# shellcheck source=set_env_context.sh
if ! source "${script_dir}/set_env_context.sh" 2>/dev/null; then
    echo "[wt-ctl] no generated context env in $(pwd); running without it" >&2
fi

export PYTHONPATH="${script_dir}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m wt_ctl "$@"
